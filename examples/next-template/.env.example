# Privy Configuration
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Wallet Connect Project ID
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_DELEGATOR_URL=
# Network Configuration -- main | test | solo
NEXT_PUBLIC_NETWORK_TYPE=
# Transak onramp -- staging key from dashboard.transak.com (leave empty to disable)
NEXT_PUBLIC_TRANSAK_API_KEY=
# Mini-server base URL -- where /api/transak/widget-url lives. Leave empty to
# use the same origin (e.g. https://my-preview.example.com in previews).
NEXT_PUBLIC_TRANSAK_API_URL=
# Transak backend credentials -- used by /api/transak/widget-url to mint a Secure Widget URL
TRANSAK_API_KEY=
TRANSAK_API_SECRET=